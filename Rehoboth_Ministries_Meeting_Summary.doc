<head>
  <meta charset="utf-8">
  <title>Rehoboth Ministries — Webinar Landing Page Revamp Meeting Summary</title>
  <!--[if gte mso 9]>
  <xml>
    <w:WordDocument>
      <w:View>Print</w:View>
      <w:Zoom>100</w:Zoom>
      <w:DoNotOptimizeForBrowser/>
